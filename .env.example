# Lobster AI: example environment file
#
# You do not need this file to use Lobster AI. `lobster init` asks for your
# provider and key and saves them for you: in the .env of the project folder,
# or with `lobster init --global` in ~/.config/lobster/credentials.env
# (%APPDATA%\lobster\credentials.env on Windows).
#
# Use this file for a source checkout (`make dev-install` copies it to .env),
# for CI or for scripts. Uncomment only the lines you need.
#
# Every setting: https://docs.omics-os.com/docs/getting-started/configuration

# =============================================================================
# LLM provider: set ONE
# =============================================================================
# Valid: omics-os | anthropic | bedrock | gemini | openai | openrouter |
#        nebius | azure | ollama | ollama-cloud
# Used only when no project or global configuration names a provider.
# LOBSTER_LLM_PROVIDER=omics-os

# Omics-OS Cloud (the default; managed models). Key from https://app.omics-os.com/account
# OMICS_OS_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# AWS Bedrock
# AWS_BEDROCK_ACCESS_KEY=
# AWS_BEDROCK_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1                  # optional, default us-east-1

# Google Gemini
# GOOGLE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Nebius AI Studio
# NEBIUS_API_KEY=

# Azure AI
# AZURE_AI_ENDPOINT=https://your-project.inference.ai.azure.com/
# AZURE_AI_CREDENTIAL=

# Ollama Cloud
# OLLAMA_API_KEY=

# Local Ollama (no key; no messages go to an LLM provider)
# OLLAMA_BASE_URL=http://localhost:11434   # optional, this is the default
# OLLAMA_DEFAULT_MODEL=gpt-oss:20b         # optional, pins the model

# =============================================================================
# Literature and dataset search (optional)
# =============================================================================
# NCBI_API_KEY=                         # higher NCBI rate limit
# NCBI_EMAIL=you@example.org            # sent to NCBI with each request

# =============================================================================
# Agents and models (optional)
# =============================================================================
# Profile: development | production (default) | performance | max | hybrid
# LOBSTER_PROFILE=production

# Thinking preset for all agents: disabled | light | standard | extended | deep
# LOBSTER_GLOBAL_THINKING=standard

# =============================================================================
# Application (optional)
# =============================================================================
# LOBSTER_WORKSPACE=./.lobster_workspace  # workspace folder
# LOBSTER_LANG=zh                         # interface language (zh = Simplified Chinese)
# LOBSTER_LOG_LEVEL=WARNING
# LOBSTER_MAX_FILE_SIZE_MB=500
# LOBSTER_SKIP_UPDATE_CHECK=1             # no check for a newer version
# LOBSTER_MODALITY_MEMORY_BUDGET_GB=8     # spill old dataset versions to disk above this; 0 = never
# LOBSTER_SHARE_MODALITY_BUFFERS=0        # keep a separate copy of each dataset version

# `lobster serve` listens on 127.0.0.1 unless you pass --host; any other
# address also needs a token.
# LOBSTER_SERVE_TOKEN=
