      "emitted_by": "go_tui"
    },
    {
      "type": "resize",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "slash_command",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "completion_request",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "component_response",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "decision_answer",
      "direction": "ui_to_engine",
      "emitted_by": "stdio hosts"
    }
  ],
  "x-exit-codes": {
    "0": "quit or EOF on stdin",
    "1": "unexpected failure",
    "other": "startup diagnostic exit code"
  },
  "x-provisional": {
    "status": "Frozen for consumers: envelope fields, the message inventory, run_state states with result, error, reason and decision, component_render payloads and id, decision_answer, done summaries. Provisional: the items listed here.",
    "items": [
      "shared-interaction.v1.lobster-profile.schema.json (whole file)"
    ]
  }
}
