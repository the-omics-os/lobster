      "direction": "engine_to_ui",
      "emitted_by": "none (declared in Go, reserved)"
    },
    {
      "type": "run_state",
      "direction": "engine_to_ui",
      "emitted_by": "lobster agent --stdio only"
    },
    {
      "type": "input",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "form_response",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
      "type": "confirm_response",
      "direction": "ui_to_engine",
      "emitted_by": "go_tui"
    },
    {
