{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.the-omics-os/lobster",
  "title": "Lobster AI",
  "description": "Bioinformatics analyses from plain-language questions: single-cell, bulk RNA-seq, proteomics, more.",
  "repository": {
    "url": "https://github.com/the-omics-os/lobster",
    "source": "github"
  },
  "websiteUrl": "https://docs.omics-os.com/docs/guides/lobster-mcp",
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "lobster-ai",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "--stdio" }
      ]
    }
  ]
}
